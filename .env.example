# ===== Groq (LLM) =====
# Get a free key at https://console.groq.com/keys  -> copy this file to ".env" and paste it below.
GROQ_API_KEY=""
# Light, fast, free-tier friendly. Alternatives: llama-3.3-70b-versatile (better, tighter limits)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=1200

# ===== Qdrant =====
# Leave QDRANT_URL empty to use embedded/local mode (data stored in QDRANT_PATH).
# For Docker / Qdrant Cloud set e.g. QDRANT_URL=http://localhost:6333 (and QDRANT_API_KEY for cloud).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=legal_cfr_chunks

# ===== Embeddings (free, local, CPU) =====
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ===== Retrieval / agent =====
TOP_K=5
MIN_SCORE=0.35
MAX_RETRIES=2
MAX_CONTEXT_CHARS=7000
VALIDATION_SNIPPET_CHARS=450

# ===== Chunking =====
CHUNK_MAX_CHARS=1800
CHUNK_MIN_CHARS=350
CHUNK_OVERLAP=200

# ===== OCR (optional; requires the Tesseract binary) =====
OCR_ENABLED=false
OCR_LANG=eng
MIN_IMAGE_PX=120

# ===== Misc =====
# Used only if the PDF text does not contain a "Revised as of ..." line. Leave empty otherwise.
DEFAULT_REVISION_DATE=
SQLITE_PATH=storage/app.db
LOG_LEVEL=INFO
